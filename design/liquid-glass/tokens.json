{
  "$schema": "https://www.designtokens.org/tr/drafts/format/",
  "color": {
    "$type": "color",
    "text": { "$value": "#F5F8FB" },
    "text-muted": { "$value": "#AABAC8" },
    "accent": { "$value": "#9FE4FF" },
    "positive": { "$value": "#83E7B8" },
    "warning": { "$value": "#FFD37A" },
    "danger": { "$value": "#FF949A" },
    "content-surface": { "$value": "#071421" },
    "control-tint": { "$value": "#526B7D" }
  },
  "space": {
    "$type": "dimension",
    "xs": { "$value": { "value": 4, "unit": "px" } },
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 12, "unit": "px" } },
    "lg": { "$value": { "value": 16, "unit": "px" } }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": { "value": 14, "unit": "px" } },
    "panel": { "$value": { "value": 18, "unit": "px" } },
    "floating": { "$value": { "value": 22, "unit": "px" } }
  },
  "motion": {
    "$type": "duration",
    "press": { "$value": { "value": 120, "unit": "ms" } },
    "focus": { "$value": { "value": 320, "unit": "ms" } },
    "morph": { "$value": { "value": 560, "unit": "ms" } },
    "page": { "$value": { "value": 400, "unit": "ms" } },
    "materialize": { "$value": { "value": 520, "unit": "ms" } }
  },
  "opacity": {
    "$type": "number",
    "content-standard": { "$value": 0.988 },
    "control-standard": { "$value": 0.604 },
    "content-high-contrast": { "$value": 1 },
    "control-high-contrast": { "$value": 0.855 }
  }
}
